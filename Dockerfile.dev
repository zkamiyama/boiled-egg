FROM debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential clang cmake ninja-build git pkg-config \
    python3 python3-venv python3-pip ffmpeg sox espeak-ng libsndfile1 libsndfile1-dev meson \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /work
COPY requirements-dev.txt /tmp/requirements-dev.txt
RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir -r /tmp/requirements-dev.txt
ENV PATH="/opt/venv/bin:${PATH}"
CMD ["bash"]
